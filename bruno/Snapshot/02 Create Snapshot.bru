meta {
  name: 02 Create Snapshot
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/accounts/{{snapshotAccountId}}/snapshots
  body: json
  auth: none
}

body:json {
  {
    "date": "2026-11-01",
    "followers": 1000
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("snapshotId", res.body.id);
}
